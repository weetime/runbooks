# Public configuration only. Registry credentials belong to the runtime's login
# store, never in this file. Copy to a local .env and fill the B300-specific values.
RUNTIME=nerdctl
RUNTIME_NAMESPACE=deepinfer-b300-bench
WORK_DIR=/data/deepinfer-vllm-b300
DATA_ROOT=/data/share/models/_datasets
MODEL_DIR=/data/share/models/DeepSeek-V4.1-Flash-1017
GPU_IDS=
# BUILD_KIT_IMAGE is filled with the verified SWR digest once preparation ends.
BUILD_KIT_IMAGE=
VLLM_IMAGE=swr.cn-north-4.myhuaweicloud.com/runner/vllm-openai@sha256:6ee133356d49ed24cee03dd0cda3d3980279a11c107ce3e752c89e76540f41c9
DATA_IMAGE=swr.cn-north-4.myhuaweicloud.com/runner/benchmark-data@sha256:983d4875ac1540e1f5c52007015d0e79203690ad345954e9b36aa1f8207a3aeb
DI_LOCAL_IMAGE=local/deepinfer-b300:a679bb86
# Set after publishing / freezing the B300-built image. Formal bench rejects tags.
DI_IMAGE=
BUILD_CPUS=16
BUILD_MEMORY=96g
MAX_JOBS=8
